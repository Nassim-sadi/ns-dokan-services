msgstr "Aucun service trouvé pour ce vendeur !"

#: includes/class-cds-store-page.php
msgid "Enter service name"
msgstr "Saisir le nom du service"

#: includes/class-cds-registration.php
msgid "I want to register as a"
msgstr "Je souhaite m'inscrire en tant que"

#: includes/class-cds-registration.php
msgid "Store — I sell products"
msgstr "Boutique — je vends des produits"

#: includes/class-cds-registration.php
msgid "Service provider — I offer services"
msgstr "Prestataire de services — je propose des services"

#: includes/class-cds-registration.php
msgid "Please select whether you are a Store or a Service provider."
msgstr "Veuillez choisir si vous êtes une Boutique ou un Prestataire de services."

#: includes/class-cds-settings.php
msgid "Services"
msgstr "Services"

#: includes/class-cds-settings.php
msgid "Services shops page"
msgstr "Page des boutiques de services"

#: includes/class-cds-settings.php
msgid "Hide services from shop"
msgstr "Masquer les services de la boutique"

#: includes/class-cds-settings.php
msgid "Hide service listings from the shop and product archives."
msgstr "Masquer les annonces de services de la boutique et des archives produits."

#: includes/class-cds-settings.php
msgid "Hide services from search"
msgstr "Masquer les services de la recherche"

#: includes/class-cds-settings.php
msgid "Hide service listings from search results."
msgstr "Masquer les annonces de services des résultats de recherche."

#: includes/class-cds-settings.php
msgid "Hide service shops from default listing"
msgstr "Masquer les boutiques de services de la liste par défaut"

#: includes/class-cds-settings.php
msgid "Hide service-provider shops from every Dokan store listing except the page assigned above."
msgstr "Masquer les boutiques de prestataires de services de toutes les listes de boutiques Dokan, sauf la page définie ci-dessus."

#: includes/class-cds-settings.php
msgid "Restrict service-vendor dashboard"
msgstr "Restreindre le tableau de bord des prestataires de services"

#: includes/class-cds-settings.php
msgid "Hide Products, Orders and Withdraw menus in the Dokan dashboard for service vendors."
msgstr "Masquer les menus Produits, Commandes et Retraits du tableau de bord Dokan pour les prestataires de services."

#: includes/class-cds-settings.php
msgid "Configure how \"Prestataire de services\" shops and their service listings behave."
msgstr "Configurez le comportement des boutiques « Prestataire de services » et de leurs annonces de services."

#: includes/class-cds-settings.php
msgid "— Select a page —"
msgstr "— Sélectionnez une page —"

#: includes/class-cds-settings.php
msgid "The Dokan store listing on this page (and its translations) will show service providers only. Leave empty to disable."
msgstr "La liste des boutiques Dokan sur cette page (et ses traductions) n'affichera que les prestataires de services. Laissez vide pour désactiver."

